NODE_ENV=production
PORT=3000
HOST_PORT=3208
KINDERGARTEN_ENV=prod
COMPOSE_PROJECT_NAME=oc-kindergarten-prod
APP_IMAGE=oc-kindergarten:prod
MIGRATOR_IMAGE=oc-kindergarten-migrator:prod
POSTGRES_DATA_DIR=/opt/persist/oc-kindergarten/prod/postgres
EXPECTED_PUBLIC_ORIGIN=https://kindergarten.rococo.dev
NEXT_PUBLIC_APP_NAME=OC Kindergarten
NEXT_PUBLIC_KINDERGARTEN_ENV=prod
BETA_COHORT=private-beta-2026

# prod 使用同一个 Casdoor issuer，但必须使用 prod 自己的 OAuth client 和回调地址。
NEXTAUTH_URL=https://kindergarten.rococo.dev
NEXTAUTH_SECRET=replace-with-a-prod-only-random-nextauth-secret
CASDOOR_ISSUER_URL=https://casdoor.rococo.dev
CASDOOR_CLIENT_ID=replace-with-prod-casdoor-application-client-id
CASDOOR_CLIENT_SECRET=replace-with-prod-casdoor-application-client-secret

POSTGRES_USER=oc_kindergarten_user
POSTGRES_PASSWORD=replace-with-a-prod-only-url-safe-database-password
POSTGRES_DB=oc_kindergarten
DATABASE_URL=postgresql://oc_kindergarten_user:replace-with-a-prod-only-url-safe-database-password@postgres:5432/oc_kindergarten
DATABASE_POOL_MAX=10

OC_KINDERGARTEN_ADMIN_TOKEN=replace-with-a-prod-only-random-token
OC_KINDERGARTEN_ADMIN_SESSION_SECRET=replace-with-another-prod-only-random-secret
OC_KINDERGARTEN_ENABLE_STRESS_TEST=0
OC_KINDERGARTEN_AGENT_EVENT_TOKEN=replace-with-a-prod-only-random-agent-event-token
